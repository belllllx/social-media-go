        "/auth/register/verify-otp": {
            "post": {
                "description": "verify otp and create user",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "parameters": [
